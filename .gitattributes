# Normalise line endings so the repository stays consistent across platforms.
* text=auto eol=lf

# Windows-only scripts keep CRLF if they ever appear.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets are never touched.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.db binary
*.sqlite binary

# Keep generated bundles out of diffs entirely.
frontend/dist/** linguist-generated=true
frontend/package-lock.json linguist-generated=true

# Documentation images are documentation, not vendored code.
docs/images/** linguist-documentation=true
