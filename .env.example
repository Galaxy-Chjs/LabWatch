# LabWatch Lite configuration
#
# Copy to `.env` (docker compose reads it automatically) or export the
# variables in your shell. Every value shown is the default.

# ---------------------------------------------------------------------------
# Collection cadence
# ---------------------------------------------------------------------------

# How often the dashboard refreshes live metrics, in seconds.
LABWATCH_POLL_INTERVAL=2

# How often a row is written to the history database, in seconds.
LABWATCH_HISTORY_INTERVAL=10

# How long history is kept, in hours.
LABWATCH_RETENTION_HOURS=24

# Safety cap on rows per history table (oldest rows are pruned first).
LABWATCH_RETENTION_MAX_ROWS=200000

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

LABWATCH_HOST=0.0.0.0
LABWATCH_PORT=8000
LABWATCH_LOG_LEVEL=INFO

# Comma-separated list of allowed browser origins, or * for any.
LABWATCH_CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Directory holding labwatch.db. Defaults to the platform data directory
# (~/.local/share/labwatch on Linux, %LOCALAPPDATA%\labwatch on Windows).
#LABWATCH_DATA_DIR=/data

# Full SQLAlchemy URL. Overrides LABWATCH_DATA_DIR when set.
#LABWATCH_DATABASE_URL=sqlite:////data/labwatch.db

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------

# Serve synthetic GPUs/processes/history. Useful for demos and screenshots on
# machines without an NVIDIA GPU. Clearly labelled "Demo Data" in the UI.
LABWATCH_DEMO_MODE=false

# Persist history in the background. Disable for tests or one-shot API use.
LABWATCH_ENABLE_BACKGROUND_COLLECTOR=true

# Resolve full process command lines. Disable to avoid reading other users'
# command lines (or where /proc access is restricted).
LABWATCH_COLLECT_COMMANDS=true

# Also list graphics contexts (NVML "G" processes). On Windows desktops this
# includes every compositing GUI application, so it is off by default.
LABWATCH_INCLUDE_GRAPHICS_PROCESSES=false

# Maximum number of GPU processes enriched per sample.
LABWATCH_PROCESS_LIMIT=64

# Report every real filesystem, not just the root one. On a lab server the disk
# that fills up is usually a data volume, so hiding the others hides the problem.
LABWATCH_INCLUDE_ALL_MOUNTS=true

# Safety cap on how many filesystems are reported.
LABWATCH_MAX_MOUNTS=8

# Serve a pre-built frontend from this directory (Docker sets /app/static).
#LABWATCH_STATIC_DIR=/app/static

# ---------------------------------------------------------------------------
# Docker Compose only
# ---------------------------------------------------------------------------

# Host port published by docker compose.
LABWATCH_PUBLISH_PORT=8000
