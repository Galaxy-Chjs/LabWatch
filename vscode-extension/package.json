{
  "name": "labwatch-gpu-status",
  "displayName": "LabWatch GPU Monitor",
  "description": "See your NVIDIA GPU state in the status bar and sidebar, and open the LabWatch dashboard. Works locally and over Remote-SSH.",
  "version": "1.3.2",
  "publisher": "galaxy-chjs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Galaxy-Chjs/LabWatch"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "gpu",
    "nvidia",
    "cuda",
    "monitoring",
    "remote-ssh"
  ],
  "icon": "media/icon.png",
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "LabWatch",
      "properties": {
        "labwatch.pythonPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Command used to run the LabWatch collector. Tried **first**, before anything else. Leave empty to let the extension find it: `labwatch` on `PATH`, then `python3 -m labwatch`, then the private environment it can create for you.",
          "scope": "resource"
        },
        "labwatch.autoSetup": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Offer to build a private environment on first use when no collector is found. It lives inside this extension's storage folder \u2014 nothing global is installed and `PATH` is not modified."
        },
        "labwatch.pipIndexUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Alternative package index used when setting the collector up, for machines that cannot reach PyPI directly (an internal mirror, for example). Example: `https://pypi.tuna.tsinghua.edu.cn/simple`."
        },
        "labwatch.refreshInterval": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 300,
          "description": "Seconds between automatic refreshes."
        },
        "labwatch.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show GPU state in the status bar."
        },
        "labwatch.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Start the collector in the background when a workspace is opened and nothing is running yet."
        },
        "labwatch.dashboardPort": {
          "type": "number",
          "default": 8123,
          "description": "Port the dashboard is served on. Over Remote-SSH the editor forwards it for you."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "labwatch",
          "title": "LabWatch",
          "icon": "media/labwatch.png"
        }
      ]
    },
    "views": {
      "labwatch": [
        {
          "id": "labwatch.gpus",
          "name": "GPUs",
          "icon": "media/labwatch.png"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "labwatch.gpus",
        "contents": "**LabWatch is a view onto a collector.** Nothing to show yet.\n\n[Start the collector](command:labwatch.start)\n[Set up the collector](command:labwatch.setup)\n[How to connect](command:labwatch.showGuide)\n\nAlready running it elsewhere? Point `labwatch.pythonPath` at it and run **LabWatch: Refresh**."
      }
    ],
    "commands": [
      {
        "command": "labwatch.openDashboard",
        "title": "LabWatch: Open Full Dashboard",
        "category": "LabWatch"
      },
      {
        "command": "labwatch.start",
        "title": "LabWatch: Start in Background",
        "category": "LabWatch"
      },
      {
        "command": "labwatch.stop",
        "title": "LabWatch: Stop",
        "category": "LabWatch"
      },
      {
        "command": "labwatch.refresh",
        "title": "LabWatch: Refresh",
        "category": "LabWatch",
        "icon": "$(refresh)"
      },
      {
        "command": "labwatch.doctor",
        "title": "LabWatch: Run Doctor",
        "category": "LabWatch"
      },
      {
        "command": "labwatch.showStatus",
        "title": "LabWatch: Show GPU Summary",
        "category": "LabWatch"
      },
      {
        "command": "labwatch.setup",
        "title": "LabWatch: Set Up Collector",
        "category": "LabWatch",
        "icon": "$(cloud-download)"
      },
      {
        "command": "labwatch.showManualSteps",
        "title": "LabWatch: Install the Collector Myself",
        "category": "LabWatch",
        "icon": "$(terminal)"
      },
      {
        "command": "labwatch.showGuide",
        "title": "LabWatch: How to Connect",
        "category": "LabWatch",
        "icon": "$(book)"
      },
      {
        "command": "labwatch.openSettings",
        "title": "LabWatch: Open Settings",
        "category": "LabWatch",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "labwatch.refresh",
          "when": "view == labwatch.gpus",
          "group": "navigation"
        },
        {
          "command": "labwatch.openDashboard",
          "when": "view == labwatch.gpus",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "labwatch.showStatus",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "labwatch.start",
          "when": "view == labwatch.gpus && viewItem == labwatch.stopped",
          "group": "inline"
        },
        {
          "command": "labwatch.setup",
          "when": "view == labwatch.gpus && viewItem == labwatch.setup.installable",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc -p ./ --noEmit",
    "test": "node --test out/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "~5.9.3"
  }
}
